# App
VITE_APP_TITLE="Seminar my pham"

# Supabase - public (safe for the client bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase - server only, never exposed to the client bundle
SUPABASE_SERVICE_ROLE_KEY=

# Optional: absolute origin override for server-rendered links.
# Leave unset locally/preview - admin link generation falls back to the
# current request/window origin automatically.
SERVER_URL=
